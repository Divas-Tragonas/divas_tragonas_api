# App
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Auth
JWT_SECRET=change-me-to-a-random-secret-at-least-16-chars
ADMIN_PASSWORD=changeme

# Max body size (bytes) accepted when saving a game session to the server.
# Saved state carries base64 images/video and can reach tens of MB. Default 80MB.
MAX_UPLOAD_BYTES=83886080

# Shared key for the /sync WebSocket (required when the API is exposed publicly
# via Tailscale Funnel). Leave empty to allow open access on the LAN.
# Generate with: openssl rand -hex 16
SYNC_KEY=

# MongoDB connection URL (used directly by the app)
# For local dev without Docker: mongodb://localhost:27017/divas_tragonas
# For Docker: constructed by docker-compose from the vars below
MONGO_URL=mongodb://localhost:27017/divas_tragonas

# MongoDB credentials (used by docker-compose to build MONGO_URL and init the db container)
MONGO_USER=api
MONGO_PASSWORD=changeme
MONGO_DB=divas_tragonas
